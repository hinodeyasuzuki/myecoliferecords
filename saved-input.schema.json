{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hinodeyasuzuki.github.io/homeenergycodes-public/input/saved-input.schema.json",
  "title": "Home Energy Codes Saved Input",
  "type": "object",
  "required": [
    "input",
    "inputCounts",
    "room",
    "products",
    "energy",
    "energycost",
    "repairlog",
    "picture"
  ],
  "additionalProperties": false,
  "properties": {
    "pictureBlobs": {
      "type": "object",
      "description": "picture の各IDに対応する画像データURL。通常はIndexedDBに保存されており、JSONエクスポート/インポート時のみこのキーとして同梱される(必須ではない)。",
      "additionalProperties": { "type": "string" }
    },
    "input": {
      "type": "object",
      "patternProperties": {
        "^i[0-9]+$": {
          "oneOf": [
            { "type": "number" },
            {
              "type": "array",
              "items": { "type": "number" }
            }
          ]
        }
      },
      "additionalProperties": true
    },
    "inputCounts": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "room": {
      "type": "object",
      "patternProperties": {
        "^r[0-9]+$": {
          "type": "object",
          "required": ["name", "area", "connected_room_ids"],
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string" },
            "area": { "type": ["number", "null"] },
            "connected_room_ids": {
              "type": "array",
              "items": { "type": "string", "pattern": "^r[0-9]+$" }
            }
          }
        }
      },
      "additionalProperties": true
    },
    "products": {
      "type": "object",
      "patternProperties": {
        "^e[0-9]+$": {
          "type": "object",
          "required": [
            "name",
            "equip_id",
            "purchaseyear",
            "purchasemonth",
            "method",
            "manufactureyear",
            "room_id",
            "watt",
            "usagetime",
            "frequency",
            "enduseyear",
            "favorite",
            "repairlog_ids",
            "picture_ids",
            "memory"
          ],
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string" },
            "equip_id": { "type": "string" },
            "purchaseyear": { "type": ["number", "null"] },
            "purchasemonth": { "type": ["number", "null"] },
            "method": { "type": ["number", "null"], "enum": [1, 2, 3, 4, 5, null] },
            "manufactureyear": { "type": ["number", "null"] },
            "room_id": { "type": "string" },
            "watt": { "type": ["number", "null"] },
            "usagetime": { "type": ["number", "null"] },
            "frequency": { "type": ["number", "null"] },
            "enduseyear": { "type": ["number", "null"] },
            "favorite": { "type": "boolean" },
            "repairlog_ids": {
              "type": "array",
              "items": { "type": "string", "pattern": "^l[0-9]+$" }
            },
            "picture_ids": {
              "type": "array",
              "items": { "type": "string", "pattern": "^p[0-9]+$" }
            },
            "memory": { "type": "string" }
          }
        }
      },
      "additionalProperties": true
    },
    "energy": {
      "type": "object",
      "patternProperties": {
        "^[0-9]{6}$": {
          "type": "object",
          "additionalProperties": { "type": "number" }
        }
      },
      "additionalProperties": true
    },
    "energycost": {
      "type": "object",
      "patternProperties": {
        "^[0-9]{6}$": {
          "type": "object",
          "additionalProperties": { "type": "number" }
        }
      },
      "additionalProperties": true
    },
    "repairlog": {
      "type": "object",
      "patternProperties": {
        "^l[0-9]+$": {
          "type": "object",
          "required": ["year", "month", "day", "equip_id", "about", "picture_ids", "created_at"],
          "additionalProperties": false,
          "properties": {
            "year": { "type": ["number", "null"] },
            "month": { "type": ["number", "null"] },
            "day": { "type": ["number", "null"] },
            "equip_id": { "type": "string" },
            "about": { "type": "string" },
            "picture_ids": {
              "type": "array",
              "items": { "type": "string", "pattern": "^p[0-9]+$" }
            },
            "created_at": { "type": "string", "format": "date-time" }
          }
        }
      },
      "additionalProperties": true
    },
    "picture": {
      "type": "object",
      "patternProperties": {
        "^p[0-9]+$": {
          "type": "object",
          "required": ["memo", "created_at", "sourceUrl"],
          "additionalProperties": false,
          "properties": {
            "memo": { "type": "string" },
            "created_at": { "type": "string", "format": "date-time" },
            "sourceUrl": { "type": "string" }
          }
        }
      },
      "additionalProperties": true
    }
  }
}
